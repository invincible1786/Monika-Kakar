<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force non-www canonical and HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.monikakakar\.in$ [NC]
  RewriteRule ^(.*)$ https://monikakakar.in/$1 [L,R=301]

  # Alias /sitemap.xml to /sitemap-index.xml
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
</IfModule>
