---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Page not found | Monika Kakar" description="This page could not be found.">
  <section class="py-24">
    <div class="container-x max-w-2xl">
      <h1 class="text-display font-bold">This page is not here</h1>
      <p class="mt-4 text-lg text-muted">The link may be old or mistyped. These pages will help:</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/about/" class="btn btn-ghost">About</a>
        <a href="/contact/" class="btn btn-ghost">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
