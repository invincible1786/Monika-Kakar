---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { business, person, getBreadcrumbSchema } from '../data/schema';

interface CardItem {
  icon: 'phone' | 'mail' | 'pin' | 'chat' | 'check' | 'chevron' | 'arrow' | 'close';
  title: string;
  text: string;
  href: string;
  track: string;
  cls: string;
  ext?: boolean;
}

const cards: CardItem[] = [
  { icon: 'phone', title: 'Call Monika Directly', text: site.phone, href: `tel:${site.phoneRaw}`, track: 'Call Click', cls: 'bg-english-soft text-english' },
  { icon: 'chat', title: 'WhatsApp Chat', text: 'Instant message for batch availability', href: site.whatsapp, track: 'WhatsApp Click', cls: 'bg-wa/15 text-wa', ext: true },
  { icon: 'mail', title: 'Email Enquiry', text: site.email, href: `mailto:${site.email}`, track: 'Email Click', cls: 'bg-brass-soft text-brass' },
  { icon: 'pin', title: 'Location in Ludhiana', text: `${site.address.street}, ${site.address.city}, Punjab`, href: 'https://maps.google.com/?q=Ludhiana,Punjab', track: 'Map Click', cls: 'bg-sand text-ink', ext: true },
];

const pageTitle = "Contact Monika Kakar | Tuition Ludhiana & Online";
const pageDesc = "Get in touch with Monika Kakar for Class 11-12 tuition in Ludhiana or online. Call, WhatsApp or send an enquiry form.";
const pageUrl = `${site.url}/contact/`;

const breadcrumbs = [
  { name: 'Home', url: `${site.url}/` },
  { name: 'Contact Monika Kakar', url: pageUrl }
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    person,
    getBreadcrumbSchema(breadcrumbs)
  ]
};
---
<BaseLayout title={pageTitle} description={pageDesc} schema={contactSchema}>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="container-x pt-6">
    <ol class="flex items-center gap-2 text-xs text-muted">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><span class="text-line">/</span></li>
      <li class="font-semibold text-ink" aria-current="page">Contact</li>
    </ol>
  </nav>

  <section class="pb-20 pt-8 md:pt-14">
    <div class="container-x">
      <h1 class="hero-in-t max-w-[18ch] text-display font-bold">Contact Monika Kakar</h1>
      <p class="hero-in mt-4 max-w-[56ch] text-lg text-muted" style="--d:120ms">
        Connect directly to enquire about Class 11 &amp; 12 batch schedules, demo classes, and curriculum roadmaps for CBSE, ICSE/ISC, and IB.
      </p>

      <div class="mt-12 grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:gap-12">
        <div class="space-y-4" data-reveal-group>
          {cards.map((c) => (
            <a href={c.href} data-track={c.track} {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}
              class="card group flex items-center gap-4 p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lift">
              <span class={`grid size-12 shrink-0 place-items-center rounded-full ${c.cls}`}><Icon name={c.icon} size={22} /></span>
              <span class="min-w-0">
                <span class="block font-semibold">{c.title}</span>
                <span class="block truncate text-sm text-muted">{c.text}</span>
              </span>
              <Icon name="arrow" size={18} class="ml-auto shrink-0 text-muted transition group-hover:translate-x-1" />
            </a>
          ))}

          <!-- NAP & Hours Card (Task 3.5) -->
          <div class="card p-6 bg-paper/60">
            <h2 class="text-base font-bold text-navy">Business Hours &amp; Centre Details</h2>
            <div class="mt-3 space-y-1.5 text-xs text-muted leading-relaxed">
              <p><strong>Business Name:</strong> {site.brandName}</p>
              <p><strong>Educator:</strong> Monika Kakar (UGC NET Qualified, M.Ed.)</p>
              <p><strong>Address:</strong> {site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}, India</p>
              <p><strong>Hours:</strong> {site.openingHours.display}</p>
              <p><strong>Modes:</strong> In-person (Ludhiana) &amp; Live Online (Pan-India)</p>
            </div>

            <div class="mt-4 pt-3 border-t border-line/60">
              <p class="text-xs font-semibold text-ink">Serving Localities Across Ludhiana:</p>
              <p class="mt-1 text-xs text-muted">{site.localities.join(', ')}</p>
            </div>
          </div>
        </div>

        <div>
          <ContactForm />

          <!-- Google Maps Embed / Facade (Task 3.5 & Task 4.2 lazy-loaded) -->
          <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-paper shadow-soft">
            <div class="p-4 bg-sand/30 border-b border-line flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold text-ink">Centre Location in Ludhiana</p>
                <p class="text-xs text-muted">Model Town &amp; Sarabha Nagar Area, Ludhiana, Punjab</p>
              </div>
              <a href="https://maps.google.com/?q=Ludhiana,Punjab" target="_blank" rel="noopener" class="text-xs font-semibold text-brass hover:underline inline-flex items-center gap-1">
                Open in Maps <Icon name="arrow" size={13} class="-rotate-45" />
              </a>
            </div>
            <iframe
              title="Monika Kakar Tuition Location Ludhiana"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d109552.19658197775!2d75.7872709!3d30.900965!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391a837462345a7d%3A0x681102348ec60610!2sLudhiana%2C%20Punjab!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
              width="100%"
              height="260"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full">
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
