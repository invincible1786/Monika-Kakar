---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { site, authoritativeLinks } from '../data/site';
import { getBreadcrumbSchema, getCourseSchema, getFAQSchema, business, person } from '../data/schema';

const pageTitle = "Sociology Tuition Ludhiana | Class 11 & 12 | Monika Kakar";
const pageDesc = "Class 11-12 Sociology tuition in Ludhiana for CBSE. Taught by M.A. Sociology & UGC NET educator. In-person & live online batches.";
const pageUrl = `${site.url}/sociology-tuition-ludhiana/`;

const sociologyFaqs = [
  {
    q: "Why is specialized tuition recommended for Sociology?",
    a: "Sociology requires using precise academic sociological vocabulary rather than everyday general opinions. Students must understand sociological frameworks, methods of social research, and institutional dynamics to score high marks in subjective board evaluations."
  },
  {
    q: "What are Monika Kakar's credentials in Sociology?",
    a: "Monika holds a Master of Arts (M.A.) in Sociology from Panjab University and is UGC NET/SLET qualified for Assistant Professor eligibility. She has guided senior secondary students through board curriculums for over 15 years."
  },
  {
    q: "How do you help students with the Class 12 Sociology project work?",
    a: "Complete mentorship is provided for selecting appropriate research topics, designing questionnaires and interview schedules, conducting empirical fieldwork, and compiling the viva presentation folder according to board guidelines."
  },
  {
    q: "Where in Ludhiana are the Sociology classes held?",
    a: "Classes take place at our learning centre in Ludhiana, centrally accessible for students from Sarabha Nagar, Model Town, BRS Nagar, Pakhowal Road, and Civil Lines, with online live interactive sessions for students pan-India."
  }
];

const breadcrumbs = [
  { name: 'Home', url: `${site.url}/` },
  { name: 'Sociology Tuition Ludhiana', url: pageUrl }
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    person,
    getBreadcrumbSchema(breadcrumbs),
    getFAQSchema(sociologyFaqs),
    getCourseSchema({
      name: 'Class 11 & 12 Sociology Tuition (CBSE)',
      description: 'Senior secondary Sociology coaching covering social stratification, institutional dynamics, demographic changes, and board exam answer writing in Ludhiana.',
      url: pageUrl,
      courseCode: 'SOC-11-12'
    })
  ]
};
---
<BaseLayout title={pageTitle} description={pageDesc} schema={pageSchema}>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="container-x pt-6">
    <ol class="flex items-center gap-2 text-xs text-muted">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><span class="text-line">/</span></li>
      <li class="font-semibold text-ink" aria-current="page">Sociology Tuition Ludhiana</li>
    </ol>
  </nav>

  <!-- Hero Section -->
  <section class="py-12 md:py-16">
    <div class="container-x max-w-4xl">
      <ul class="flex flex-wrap gap-2" aria-label="Credentials">
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> M.A. Sociology, Panjab University</li>
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> UGC NET Qualified</li>
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> 15 Years Academic Experience</li>
      </ul>

      <h1 class="mt-6 text-display font-bold">
        Class 11 &amp; 12 Sociology Tuition in Ludhiana
      </h1>

      <p class="mt-6 text-xl text-muted leading-relaxed">
        Understand the structural dynamics, institutional shifts, and cultural transformations of Indian society. Taught by Monika Kakar, an M.A. Sociology post-graduate and UGC NET qualified educator dedicated to turning sociological insights into exceptional board examination scores.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary" data-track="Enquiry Click">
          Enquire for Sociology batch <Icon name="arrow" size={18} />
        </a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-ghost" data-track="Call Click">
          <Icon name="phone" size={18} /> Call {site.phone}
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-wa" data-track="WhatsApp Click">
          <Icon name="chat" size={18} /> WhatsApp
        </a>
      </div>

      <p class="mt-4 text-xs text-muted">
        In-person coaching in Ludhiana (Model Town, Sarabha Nagar, Pakhowal Road) &amp; Live Online pan-India
      </p>
    </div>
  </section>

  <!-- Syllabus Breakdown -->
  <section class="border-t border-line/60 bg-paper/50 py-16 md:py-24">
    <div class="container-x max-w-5xl">
      <div class="max-w-3xl">
        <h2 class="text-h2 font-bold">Sociology Curriculum &amp; Conceptual Blueprint</h2>
        <p class="mt-3 text-muted">
          Board examiners reward structured arguments using sociological concepts such as Sanskritisation, Westernisation, structural differentiation, and demographic transitions rather than colloquial commentary.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <!-- Class 11 Card -->
        <div class="card p-7 sm:p-8 border-l-4 !border-l-sociology">
          <span class="badge text-sociology bg-sociology-soft font-semibold">Class 11 Foundation</span>
          <h3 class="mt-4 text-2xl font-bold">Introducing &amp; Understanding Society</h3>
          <p class="mt-2 text-sm text-muted">Mastering core sociological concepts, institutional structures, and qualitative research methods.</p>

          <ul class="mt-6 space-y-3 text-sm text-ink/90">
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-sociology" /><span><strong>Sociological Imagination:</strong> Society and the individual, sociological perspectives vs common sense.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-sociology" /><span><strong>Terms, Concepts &amp; Usage:</strong> Social groups, status and role, social control, and social stratification.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-sociology" /><span><strong>Social Institutions:</strong> Family, marriage, kinship, economic institutions, political systems, and religion.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-sociology" /><span><strong>Culture &amp; Socialisation:</strong> Enculturation, ethnocentrism, cultural lag, and agencies of socialisation.</span></li>
          </ul>
        </div>

        <!-- Class 12 Card -->
        <div class="card p-7 sm:p-8 border-l-4 !border-l-navy">
          <span class="badge text-navy bg-sand font-semibold">Class 12 Board Focus</span>
          <h3 class="mt-4 text-2xl font-bold">Indian Society: Structure &amp; Transformation</h3>
          <p class="mt-2 text-sm text-muted">Comprehensive analytical training for board examinations and empirical project submissions.</p>

          <ul class="mt-6 space-y-3 text-sm text-ink/90">
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Demographic Structure of India:</strong> Age pyramids, rural-urban migration, sex ratio trends, and population policies.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Social Inequality &amp; Exclusion:</strong> Caste systems, tribal communities, gender discrimination, and constitutional safeguards.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Structural &amp; Cultural Change:</strong> Colonialism, industrialisation, urbanisation, Sanskritisation, and secularisation.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Social Movements &amp; Change:</strong> Agrarian movements, environmental campaigns, Dalit movements, and mass media impact.</span></li>
          </ul>
        </div>
      </div>

      <!-- Pedagogy details -->
      <div class="mt-14 rounded-2xl border border-line bg-paper p-8">
        <h3 class="text-2xl font-bold">High-Scoring Answer Writing Methodology</h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          <div>
            <h4 class="font-bold text-navy">Academic Sociological Terminology</h4>
            <p class="mt-2 text-sm text-muted">Train students to replace layman language with precise sociological terms, citing eminent sociologists (M.N. Srinivas, G.S. Ghurye, Yogendra Singh).</p>
          </div>
          <div>
            <h4 class="font-bold text-navy">Contextual Indian Case Examples</h4>
            <p class="mt-2 text-sm text-muted">Illustrating structural theories with contemporary Indian census data, welfare policies, and grassroots transformations.</p>
          </div>
          <div>
            <h4 class="font-bold text-navy">Project &amp; Viva Mentorship</h4>
            <p class="mt-2 text-sm text-muted">Guidance on questionnaire construction, data collection, and viva preparation to secure the full 20 practical marks.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Authoritative Links Context -->
  <section class="py-14">
    <div class="container-x max-w-5xl">
      <div class="rounded-2xl border border-line bg-paper p-6 sm:p-8">
        <h3 class="text-lg font-bold">Official Senior Secondary Curriculum Portals</h3>
        <p class="mt-1 text-sm text-muted">Curriculum outlines, sample papers, and marking criteria strictly follow board guidelines:</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm">
          {authoritativeLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="font-medium text-navy hover:underline inline-flex items-center gap-1">
              <span>{link.name}</span>
              <Icon name="arrow" size={13} class="-rotate-45 text-muted" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-14 bg-paper/40 border-t border-line/60" aria-labelledby="sociology-faq-heading">
    <div class="container-x max-w-4xl">
      <h2 id="sociology-faq-heading" class="text-h2 font-bold text-center">Frequently Asked Questions: Sociology Tuition</h2>
      <p class="mt-3 text-center text-muted">Key details about Sociology batches, evaluation methods, and study roadmaps.</p>
      <div class="mt-8">
        <FAQ items={sociologyFaqs} idPrefix="soc-faq" />
      </div>
    </div>
  </section>

  <!-- Sibling Subject Cluster Navigation -->
  <section class="py-16 border-t border-line/60">
    <div class="container-x max-w-5xl">
      <h3 class="text-xl font-bold">Explore Sibling Humanities Subjects</h3>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <a href="/english-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-english">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">English Tuition Ludhiana &rarr;</span>
          <span class="mt-2 block text-xs text-muted">CBSE, ISC &amp; IB English literature, comprehension, and analytical composition.</span>
        </a>
        <a href="/psychology-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-psychology">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">Psychology Tuition Ludhiana &rarr;</span>
          <span class="mt-2 block text-xs text-muted">Foundations of psychology, cognitive sciences, clinical disorders, and therapies.</span>
        </a>
        <a href="/political-science-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-polsci">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">Political Science Tuition &rarr;</span>
          <span class="mt-2 block text-xs text-muted">Indian Constitution, political philosophy, and international relations.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-navy py-16 text-paper">
    <div class="container-x max-w-4xl flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-3xl font-bold">Achieve Academic Excellence in Sociology</h2>
        <p class="mt-2 text-paper/80">Schedule your consultation with Monika Kakar to enroll in the upcoming session.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-light" data-track="Enquiry Click">Book consultation</a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-ghost !border-paper/40 !bg-white/10 !text-paper hover:!bg-white/20">Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
