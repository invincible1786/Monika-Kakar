---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { site, authoritativeLinks } from '../data/site';
import { getBreadcrumbSchema, getCourseSchema, getFAQSchema, business, person } from '../data/schema';

const pageTitle = "Psychology Tuition Ludhiana | Class 11 & 12 | Monika Kakar";
const pageDesc = "Class 11-12 Psychology tuition in Ludhiana for CBSE & IB. Taught by M.Ed. specialist in Educational Psychology. In-person & online.";
const pageUrl = `${site.url}/psychology-tuition-ludhiana/`;

const psychFaqs = [
  {
    q: "Why is Psychology tuition beneficial for Class 11 and 12?",
    a: "Psychology introduces scientific terminology, experimental methodology, and clinical diagnostic criteria that are completely new to high school students. Professional guidance helps students master abstract theories, case study analysis, and precise technical answer framing."
  },
  {
    q: "What is Monika Kakar's background in Psychology?",
    a: "Monika holds a Master of Education (M.Ed.) specialising in Educational Psychology, Philosophy, and Guidance & Counselling from Panjab University, alongside an undergraduate degree in Psychology. She has over 15 years of experience mentoring senior secondary humanities students."
  },
  {
    q: "Do you provide help with Class 12 Psychology practicals and projects?",
    a: "Yes. Complete guidance is provided for conducting psychological assessments (intelligence tests, personality inventories, aptitude measures) and drafting comprehensive case study profile files as per CBSE and IB board guidelines."
  },
  {
    q: "Where in Ludhiana are the Psychology classes conducted?",
    a: "Classes take place at our tuition centre in Ludhiana, convenient for students from Sarabha Nagar, Model Town, BRS Nagar, Pakhowal Road, and Civil Lines. Interactive live online sessions are also conducted for students outside Ludhiana."
  }
];

const breadcrumbs = [
  { name: 'Home', url: `${site.url}/` },
  { name: 'Psychology Tuition Ludhiana', url: pageUrl }
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    person,
    getBreadcrumbSchema(breadcrumbs),
    getFAQSchema(psychFaqs),
    getCourseSchema({
      name: 'Class 11 & 12 Psychology Tuition (CBSE & IB)',
      description: 'Comprehensive senior secondary psychology coaching covering cognitive processes, human development, clinical disorders, therapies, and practical assessments in Ludhiana.',
      url: pageUrl,
      courseCode: 'PSY-11-12'
    })
  ]
};
---
<BaseLayout title={pageTitle} description={pageDesc} schema={pageSchema}>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="container-x pt-6">
    <ol class="flex items-center gap-2 text-xs text-muted">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><span class="text-line">/</span></li>
      <li class="font-semibold text-ink" aria-current="page">Psychology Tuition Ludhiana</li>
    </ol>
  </nav>

  <!-- Hero Section -->
  <section class="py-12 md:py-16">
    <div class="container-x max-w-4xl">
      <ul class="flex flex-wrap gap-2" aria-label="Credentials">
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> M.Ed. (Psychology, Guidance &amp; Counselling)</li>
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> Panjab University Graduate</li>
        <li class="badge"><Icon name="check" size={16} class="text-brass" /> 15 Years Academic Experience</li>
      </ul>

      <h1 class="mt-6 text-display font-bold">
        Class 11 &amp; 12 Psychology Tuition in Ludhiana
      </h1>

      <p class="mt-6 text-xl text-muted leading-relaxed">
        Concept-driven Psychology coaching bridging scientific theory with real-world behavioural case studies. Tailored for CBSE Class 11–12 and IB Diploma Psychology students aiming for top board scores and future university admissions.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary" data-track="Enquiry Click">
          Enquire for Psychology batch <Icon name="arrow" size={18} />
        </a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-ghost" data-track="Call Click">
          <Icon name="phone" size={18} /> Call {site.phone}
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-wa" data-track="WhatsApp Click">
          <Icon name="chat" size={18} /> WhatsApp
        </a>
      </div>

      <p class="mt-4 text-xs text-muted">
        In-person coaching in Ludhiana (Model Town, Sarabha Nagar, BRS Nagar) &amp; Live interactive online tuition
      </p>
    </div>
  </section>

  <!-- Syllabus Breakdown -->
  <section class="border-t border-line/60 bg-paper/50 py-16 md:py-24">
    <div class="container-x max-w-5xl">
      <div class="max-w-3xl">
        <h2 class="text-h2 font-bold">Psychology Curriculum &amp; Conceptual Blueprint</h2>
        <p class="mt-3 text-muted">
          Psychology is fundamentally a science. Our teaching emphasises empirical methodology, psychological constructs, clinical definitions, and high-scoring subjective answer templates.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <!-- Class 11 Card -->
        <div class="card p-7 sm:p-8 border-l-4 !border-l-psychology">
          <span class="badge text-psychology bg-psychology-soft font-semibold">Class 11 Fundamentals</span>
          <h3 class="mt-4 text-2xl font-bold">Scientific Foundations &amp; Human Behaviour</h3>
          <p class="mt-2 text-sm text-muted">Building strong clarity across biological bases, cognitive processes, and developmental stages.</p>

          <ul class="mt-6 space-y-3 text-sm text-ink/90">
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-psychology" /><span><strong>What is Psychology:</strong> Evolutionary paradigms, schools of thought, and scientific inquiry methods.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-psychology" /><span><strong>Methods of Enquiry:</strong> Experimental, survey, correlational studies, observations, and ethical guidelines.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-psychology" /><span><strong>Biological &amp; Sensory Bases:</strong> Nervous system, endocrine functions, brain mapping, perception, and attention.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-psychology" /><span><strong>Cognition &amp; Learning:</strong> Classical &amp; operant conditioning, memory models (Atkinson-Shiffrin), forgetting, and problem-solving.</span></li>
          </ul>
        </div>

        <!-- Class 12 Card -->
        <div class="card p-7 sm:p-8 border-l-4 !border-l-navy">
          <span class="badge text-navy bg-sand font-semibold">Class 12 Board Focus</span>
          <h3 class="mt-4 text-2xl font-bold">Clinical, Personality &amp; Applied Psychology</h3>
          <p class="mt-2 text-sm text-muted">Targeted preparation for board examinations with case vignettes and subjective answer blueprints.</p>

          <ul class="mt-6 space-y-3 text-sm text-ink/90">
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Variations in Psychological Attributes:</strong> Intelligence theories (Gardner, Sternberg), PASS model, aptitude and assessment.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Self and Personality:</strong> Freud's psychoanalytic theory, post-Freudian theorists, trait vs type, and self-efficacy.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Stress &amp; Coping:</strong> GAS model (Hans Selye), coping strategies, emotional resilience, and lifestyle factors.</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={18} class="shrink-0 text-navy" /><span><strong>Psychological Disorders &amp; Therapies:</strong> Anxiety, depressive, neurodevelopmental disorders, and CBT / psychodynamic therapies.</span></li>
          </ul>
        </div>
      </div>

      <!-- Pedagogy details -->
      <div class="mt-14 rounded-2xl border border-line bg-paper p-8">
        <h3 class="text-2xl font-bold">Why Monika Kakar's Psychology Classes Deliver 95+ Scores</h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          <div>
            <h4 class="font-bold text-navy">Exact CBSE Terminology</h4>
            <p class="mt-2 text-sm text-muted">Board examiners penalise vague wording. Students are trained to use official NCERT psychological terms and clinical definitions effortlessly.</p>
          </div>
          <div>
            <h4 class="font-bold text-navy">Case Study Application</h4>
            <p class="mt-2 text-sm text-muted">Competency-based questions require identifying disorders or theories from short real-life vignettes. We practice hundreds of case questions.</p>
          </div>
          <div>
            <h4 class="font-bold text-navy">Practical Assessment Guidance</h4>
            <p class="mt-2 text-sm text-muted">Step-by-step mentoring for administration, scoring, and viva preparation for all mandatory psychological tests.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Authoritative Links Context -->
  <section class="py-14">
    <div class="container-x max-w-5xl">
      <div class="rounded-2xl border border-line bg-paper p-6 sm:p-8">
        <h3 class="text-lg font-bold">Official Senior Secondary Curriculum Portals</h3>
        <p class="mt-1 text-sm text-muted">All learning outcomes and testing schedules adhere to the latest curriculum blueprints:</p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm">
          {authoritativeLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="font-medium text-navy hover:underline inline-flex items-center gap-1">
              <span>{link.name}</span>
              <Icon name="arrow" size={13} class="-rotate-45 text-muted" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-14 bg-paper/40 border-t border-line/60" aria-labelledby="psych-faq-heading">
    <div class="container-x max-w-4xl">
      <h2 id="psych-faq-heading" class="text-h2 font-bold text-center">Frequently Asked Questions: Psychology Tuition</h2>
      <p class="mt-3 text-center text-muted">Get clear answers about curriculum, board coverage, and study materials.</p>
      <div class="mt-8">
        <FAQ items={psychFaqs} idPrefix="psy-faq" />
      </div>
    </div>
  </section>

  <!-- Sibling Subject Cluster Navigation -->
  <section class="py-16 border-t border-line/60">
    <div class="container-x max-w-5xl">
      <h3 class="text-xl font-bold">Explore Sibling Humanities Subjects</h3>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <a href="/english-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-english">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">English Tuition Ludhiana &rarr;</span>
          <span class="mt-2 block text-xs text-muted">CBSE, ISC &amp; IB English literature, comprehension, and analytical writing.</span>
        </a>
        <a href="/political-science-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-polsci">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">Political Science Tuition &rarr;</span>
          <span class="mt-2 block text-xs text-muted">Constitutional analysis, democratic governance, and contemporary world politics.</span>
        </a>
        <a href="/sociology-tuition-ludhiana/" class="card p-5 transition hover:-translate-y-1 hover:shadow-lift">
          <span class="block text-xs font-semibold uppercase text-sociology">Specialised Tuition</span>
          <span class="mt-1 block text-lg font-bold">Sociology Tuition &rarr;</span>
          <span class="mt-2 block text-xs text-muted">Social stratification, Indian societal change, and subjective board preparation.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-navy py-16 text-paper">
    <div class="container-x max-w-4xl flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-3xl font-bold">Master Class 11–12 Psychology with Confidence</h2>
        <p class="mt-2 text-paper/80">Schedule an introductory consultation with Monika Kakar to discuss your syllabus standing.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-light" data-track="Enquiry Click">Book consultation</a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-ghost !border-paper/40 !bg-white/10 !text-paper hover:!bg-white/20">Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
