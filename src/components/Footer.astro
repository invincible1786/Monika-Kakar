---
import { site, nav } from '../data/site';
---
<footer class="border-t border-navy-soft bg-navy text-paper">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-3xl font-bold text-paper">Monika Kakar</p>
      <p class="mt-3 max-w-[38ch] text-paper/75">UGC NET-qualified teacher with an M.Ed. Class 11 and 12 tuition in {site.city} and online.</p>
    </div>
    <nav aria-label="Footer">
      <p class="font-semibold text-paper">Pages</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2.5 text-paper/80">
        {nav.map((l) => <li><a class="transition hover:text-paper hover:underline" href={l.href}>{l.label}</a></li>)}
        <li><a class="transition hover:text-paper hover:underline" href="/privacy-policy/">Privacy policy</a></li>
      </ul>
    </nav>
    <div>
      <p class="font-semibold text-paper">Contact</p>
      <ul class="mt-3 space-y-2 text-paper/80">
        <li><a class="transition hover:text-paper hover:underline" href={`tel:${site.phone}`} data-track="Call Click">{site.phone}</a></li>
        <li><a class="transition hover:text-paper hover:underline" href={`mailto:${site.email}`} data-track="Email Click">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <p class="container-x border-t border-white/10 py-5 text-center text-sm text-paper/70">
    © {new Date().getFullYear()} Monika Kakar, {site.city}
  </p>
</footer>
