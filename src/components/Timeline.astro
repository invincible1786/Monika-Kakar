---
interface Item {
  meta: string;
  title: string;
  org?: string;
  note?: string;
}

interface Props {
  id: string;
  heading: string;
  intro?: string;
  items: Item[];
}

const { id, heading, intro, items } = Astro.props;
---
<section aria-labelledby={`${id}-title`} class="py-14 md:py-20">
  <div class="container-x grid gap-10 lg:grid-cols-[17rem_1fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id={`${id}-title`} class="text-h2 font-bold">{heading}</h2>
      {intro && <p class="mt-3 text-muted">{intro}</p>}
    </div>

    <div class="timeline" data-timeline>
      <span class="tl-track" aria-hidden="true"><span class="tl-fill" data-timeline-fill></span></span>
      <ol>
        {items.map((it) => (
          <li class="tl-item" data-reveal>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="card p-5 sm:p-6">
              <p class="text-sm font-semibold text-brass">{it.meta}</p>
              <h3 class="mt-1 text-2xl font-bold">{it.title}</h3>
              {it.org && <p class="mt-1 text-muted">{it.org}</p>}
              {it.note && <p class="mt-2 text-sm text-muted">{it.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .timeline { position: relative; }
  .tl-track { position: absolute; left: .6875rem; top: 1rem; bottom: 1rem; width: 2px; border-radius: 2px; background: var(--color-line); }
  .tl-fill { position: absolute; inset: 0; border-radius: 2px; transform: scaleY(0); transform-origin: top; will-change: transform;
    background: linear-gradient(to bottom, var(--color-brass), var(--color-navy)); }
  html:not(.js) .tl-fill { transform: scaleY(1); }

  .tl-item { position: relative; padding: 0 0 1.5rem 3rem; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-dot { position: absolute; left: 0; top: 1.5rem; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    background: var(--color-cream); border: 2px solid var(--color-line);
    transition: border-color .4s, background-color .4s, box-shadow .4s; }
  .tl-item.is-visible .tl-dot, html:not(.js) .tl-dot { border-color: var(--color-brass); background: var(--color-brass); box-shadow: inset 0 0 0 4px var(--color-cream); }

  /* Native scroll-driven line (enabled by reveal.js when supported) */
  .tl-native { view-timeline-name: --tl; }
  .tl-native .tl-fill { animation: tl-grow linear both; animation-timeline: --tl; animation-range: cover 12% cover 68%; }
  @keyframes tl-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .tl-fill, .tl-native .tl-fill { animation: none; transform: scaleY(1); } .tl-dot { transition: none; } }
</style>
