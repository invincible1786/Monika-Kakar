---
const stats = [
  { count: 15, label: 'years of teaching across school, college and private tuition' },
  { count: 4, label: 'subjects: English, Psychology, Political Science, Sociology' },
  { count: 3, label: 'boards: CBSE, ICSE and IB' },
  { text: 'UGC NET', label: 'qualified (June 2011), with an M.Ed.' },
];
---
<section class="bg-navy text-paper" aria-label="Credentials">
  <ul class="container-x grid grid-cols-2 gap-3 py-10 lg:grid-cols-4 lg:gap-4" data-reveal-group>
    {stats.map((s) => (
      <li class="glass-dark rounded-2xl p-5 transition duration-300 hover:-translate-y-1 hover:bg-white/15">
        <p class="font-display text-5xl font-bold leading-none">
          {s.count
            ? <span data-count={s.count} class="inline-block min-w-[2ch] tabular-nums">{s.count}</span>
            : s.text}
        </p>
        <p class="mt-3 text-sm leading-snug text-paper/85">{s.label}</p>
      </li>
    ))}
  </ul>
</section>
